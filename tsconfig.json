{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es5", "es2015.promise", "es2015.core", "dom"],
    "module": "amd",
    "outFile": "./timelineConnector.js",
    "sourceMap": true,
    "removeComments": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": [
    "./*.ts",
    "./*.d.ts"
  ],
  "exclude": [
    "node_modules/**/*",
    "*.js",
    "*.js.map"
  ]
}
